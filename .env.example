# =============================================
# RUTS-REALAIDS Environment Variables
# Copy this file to .env and fill in values
# =============================================

# ── Database ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ruts_realaids
DATABASE_USER=realaids
DATABASE_PASSWORD=realaids1234

# ── JWT ──
JWT_SECRET=change-this-to-random-secret-key-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Backend Server ──
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Frontend (prefix NEXT_PUBLIC_ for client access) ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_MAP_CENTER_LAT=7.1907
NEXT_PUBLIC_MAP_CENTER_LNG=100.5930

# ── Timezone ──
TZ=Asia/Bangkok
