###################################################################
# SECURITY TESTS
###################################################################

### S.1 No Token — ต้อง 401
GET {{baseUrl}}/users/me

### S.2 Invalid Token — ต้อง 401
GET {{baseUrl}}/users/me
Authorization: Bearer invalid-token-here

### S.3 Expired Token — ต้อง 401
GET {{baseUrl}}/users/me
Authorization: Bearer <expired-token>

### S.4 Student access admin route — ต้อง 403
GET {{baseUrl}}/admin/users
Authorization: {{studentToken}}

### S.5 Staff access admin-only route — ต้อง 403
POST {{baseUrl}}/backups
Authorization: {{staffToken}}

### S.6 Extra field in body — ต้อง 400 (forbidNonWhitelisted)
# ⚠️  นี่คือ bug เดิม: ส่ง "role" ใน /auth/register → 400
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "test@ruts.ac.th",
  "password": "Test@1234",
  "firstName": "Test",
  "lastName": "User",
  "role": "admin"
}

### S.7 Brute Force — login ผิด 6 ครั้ง ต้อง lock
# รัน S.8 ซ้ำ 6 ครั้ง → ครั้งที่ 6 ต้องได้ "Account locked"
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "admin@ruts.ac.th",
  "password": "wrongpassword"
}


###################################################################
# WEBSOCKET TEST
###################################################################
#
# เปิด terminal แล้วรัน:
#   npm install -g wscat
#   wscat -c "ws://localhost:4000?token=<access-token>"
#
# หลัง connect จะได้ event: {"event":"connected","data":{...}}
#
# Ping test:
#   {"event":"ping","data":{}}
#   → ต้องได้: {"event":"pong","data":{"ts":...}}
#
# ทดสอบ Real-time:
#   1. เปิด 2 terminals (1=student, 1=staff)
#   2. Student แจ้งเหตุผ่าน API (step 3.1)
#   3. Staff terminal ต้องได้รับ event: incident:new
#   4. Staff accept เหตุ (step 3.6)
#   5. Student terminal ต้องได้รับ event: incident:accepted
#
